# LLM API Configuration (vLLM)
LLM_URL=http://localhost:8000/v1/chat/completions
MODEL=mistral-7b-instruct-v0.2
API_KEY=your-api-key-here

# Request Parameters
DEFAULT_TEMPERATURE=0.0
DEFAULT_MAX_TOKENS=2048
DEFAULT_TOP_P=0.95
REQUEST_TIMEOUT=120

# Evaluation Parameters
NUM_RUNS_PER_QUESTION=3  # For reproducibility testing
BATCH_SIZE=5  # Concurrent requests
DELAY_BETWEEN_REQUESTS=0.5  # Seconds

# Embedding Model for Semantic Similarity
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Alternatives: BAAI/bge-m3, intfloat/multilingual-e5-large

# Storage
DATABASE_URL=sqlite:///./results/evaluation_results.db
RESULTS_DIR=./results
EXPORT_FORMAT=jsonl  # Options: jsonl, csv, xlsx

# Logging
LOG_LEVEL=INFO
LOG_FILE=./results/evaluation.log

# Evaluation Weights (for composite scoring)
WEIGHT_RELEVANCE=0.25
WEIGHT_FACTUAL_ACCURACY=0.20
WEIGHT_COMPLETENESS=0.15
WEIGHT_FLUENCY=0.15
WEIGHT_COHERENCE=0.10
WEIGHT_PROMPT_ALIGNMENT=0.10
WEIGHT_TOKEN_EFFICIENCY=0.05

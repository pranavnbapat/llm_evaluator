# ============================================================================
# Environment Configuration for RunPod LLM Evaluation
# ============================================================================
# Copy this file to .env.runpod and fill in your actual values
# Then: source .env.runpod before running any scripts
# ============================================================================

# ----------------------------------------------------------------------------
# HuggingFace Token (required for downloading models)
# Get from: https://huggingface.co/settings/tokens
# ----------------------------------------------------------------------------
export HF_TOKEN="hf_your_token_here"

# ----------------------------------------------------------------------------
# vLLM API Key (for securing the vLLM endpoint)
# Choose any secure random string
# ----------------------------------------------------------------------------
export VLLM_API_KEY="sk-runpod-vllm-secure-key-change-me"

# ----------------------------------------------------------------------------
# OpenAI API Key (required for evaluation/judging)
# Some evaluation metrics use OpenAI models as judges
# Get from: https://platform.openai.com/api-keys
# ----------------------------------------------------------------------------
export OPENAI_API_KEY="sk-openai-your-key-here"

# ----------------------------------------------------------------------------
# Optional: Evaluation Configuration
# ----------------------------------------------------------------------------

# Number of runs per question (default: 3)
# export NUM_RUNS_PER_QUESTION=3

# Default temperature for generation (default: 0.0)
# export DEFAULT_TEMPERATURE=0.0

# Embedding model for semantic similarity
# export EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-mpnet-base-v2"

# Results directory
# export RESULTS_DIR="/workspace/evaluation_results"

# ----------------------------------------------------------------------------
# Paths (usually don't need to change)
# ----------------------------------------------------------------------------
export WORKSPACE_DIR="/workspace"
export MODELS_DIR="/workspace/models"
export VLLM_CONFIG="/workspace/vllm/current.env"
export SUPERVISOR_CONFIG="/workspace/ops/supervisord.conf"
